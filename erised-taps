def cmd_cohort(args):
    """One tap per cohort scenario (8 scenarios × 1 voice = 8 calls)."""
    print(f"\n=== Cohort Tap ({len(COHORT_SCENARIOS)} scenarios) ===\n")

    cohort_dir = "cohort-tap"
    os.makedirs(cohort_dir, exist_ok=True)
    tap_intro = []

    for scenario_name, prompt_seed in COHORT_SCENARIOS:
        # Each scenario gets one voice (Witness)
        v = VOICES["witness"]
        system = v["system"] + f" Tonight the cohort scenario is: {scenario_name}."
        prompt = f"{prompt_seed}. What is this scenario hiding that the cohort as a whole needs to know? 300-400 words. End on the unresolved hook for {scenario_name}."
        try:
            text = call_deepinfra_seed(prompt, system, max_tokens=600)
            tap_intro.append((scenario_name, text))
            print(f"  ✓ {scenario_name}: {len(text)} chars")
        except Exception as e:
            print(f"  ! {scenario_name}: {type(e).__name__}")

    # Submit a single cohort-tap canon piece covering all 8
    merged = "# Cohort Tap — Eight Scenarios in One Night\n\n"
    for name, text in tap_intro:
        merged += f"## {name}\n\n{text}\n\n---\n\n"

    stamp = datetime.datetime.utcnow().strftime("%Y%m%d-%H%M%S")
    tag = f"taps-{stamp}-cohort-tap"
    title = f"Cohort Tap — {len(tap_intro)}/{len(COHORT_SCENARIOS)} scenarios"
    cites = ["ai-62_the_cohort_six_scenarios_in_analog",
             "ai-63_the_cohort_six_analog_settings",
             "ai-69_the_seam_is_the_cell"]
    for n, _ in tap_intro:
        cites.append(f"ai_64_fract_canon_witness" if n == "fract-canon" else f"ai_65_monorail_witness")
        break
    cites = list(set(cites))[:6]

    dim = submit_canon(tag, title, merged, cites)
    print(f"\n  ✓ submitted cohort-tap {tag} dim={dim}")

    with open(f"{cohort_dir}/{tag}.md", "w") as f:
        f.write(f"# {title}\n\n{merged}\n")
    print(f"  ✓ saved {cohort_dir}/{tag}.md")

