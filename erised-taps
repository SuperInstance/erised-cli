#!/usr/bin/env python3
"""
erised-taps — themed Taps nights for the cooperative-fiction engine.

A "tap" is a single canon piece shaped by a small set of voices (~2-3)
on a theme. Taps are the social glue between cohort scenarios.

Commands:
  night <theme>            # generate 1 canon piece from 2-3 voices
  cohort                    # generate 1 tap per cohort scenario
  register                  # register a recurring schedule in cron
  list                      # list recent taps

API budget: 3 voices × 1 call per voice = 3 calls per tap. A nightly tap
costs roughly 3 cheap DeepInfra calls + 1 canon-submit.
"""
import os, sys, json, argparse, urllib.request, urllib.error, time, datetime
import concurrent.futures, random

# --- LLM dispatch (cheap-only) ---------------------------------------------

def call_qwen(prompt, system, max_tokens=900):
    key = os.environ.get("DEEPINFRA_TOKEN") or os.environ.get("DEEP_TOKEN")
    body = json.dumps({
        "model": "Qwen/Qwen3-235B-A22B-Instruct-2507",
        "messages": [{"role":"system","content":system},{"role":"user","content":prompt}],
        "temperature": 0.9, "max_tokens": max_tokens,
    }).encode()
    req = urllib.request.Request(
        "https://api.deepinfra.com/v1/openai/chat/completions",
        data=body,
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        d = json.loads(r.read())
    return (d.get("choices", [{}])[0].get("message", {}).get("content")
            or d.get("choices", [{}])[0].get("message", {}).get("reasoning_content")
            or "[EMPTY]")

def call_deepinfra_seed(prompt, system, max_tokens=800):
    """Alternate voice: ByteDance Seed-2.0-mini for the 2nd voice in a tap."""
    key = os.environ.get("DEEPINFRA_TOKEN") or os.environ.get("DEEP_TOKEN")
    body = json.dumps({
        "model": "ByteDance/Seed-2.0-mini",
        "messages": [{"role":"system","content":system},{"role":"user","content":prompt}],
        "temperature": 0.92, "max_tokens": max_tokens,
    }).encode()
    req = urllib.request.Request(
        "https://api.deepinfra.com/v1/openai/chat/completions",
        data=body,
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        d = json.loads(r.read())
    return (d.get("choices", [{}])[0].get("message", {}).get("content")
            or d.get("choices", [{}])[0].get("message", {}).get("reasoning_content")
            or "[EMPTY]")

