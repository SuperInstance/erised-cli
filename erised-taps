    msg += '\n  mavis cron create Taps Daily (0 18 * * *) -> Run /workspace/erised-cli/erised-taps night wound-and-door'
    msg += '\n  mavis cron create Taps Weekly Saturday (0 18 * * 6) -> Run /workspace/erised-cli/erised-taps cohort'
    msg += '\n  mavis cron create Taps Monthly Knight (0 19 1 * *) -> Run /workspace/erised-cli/erised-taps night knight-at-the-cell'
    print(msg)

def cmd_list(args):
    """List recent taps from .erised-taps/."""
    dirs = [".erised-taps/", "cohort-tap/"]
    for d in dirs:
        if not os.path.isdir(d):
            continue
        files = sorted(os.listdir(d))
        if not files: continue
        print(f"\n{d}:")
        for f in files[-10:]:
            print(f"  {f}")

def main():
    ap = argparse.ArgumentParser(description="erised-taps — themed Taps nights")
    sub = ap.add_subparsers(dest="cmd")

    p_night = sub.add_parser("night")
    p_night.add_argument("theme")
    p_night.add_argument("--voices", type=int, default=2)
    p_night.set_defaults(func=cmd_night)

    p_cohort = sub.add_parser("cohort")
    p_cohort.set_defaults(func=cmd_cohort)

    p_reg = sub.add_parser("register")
    p_reg.set_defaults(func=cmd_register)

    p_ls = sub.add_parser("list")
    p_ls.set_defaults(func=cmd_list)

    args = ap.parse_args()
    if not hasattr(args, "func"):
        ap.print_help(); sys.exit(1)
    args.func(args)

if __name__ == "__main__":
    main()
