def pick_voices(theme, n=2):
    """Pick n voices appropriate to the theme (deterministic from theme hash)."""
    import hashlib
    h = int(hashlib.md5(theme.encode()).hexdigest(), 16)
    # Always include one Counter + one Voice; sometimes a Skeptic
    must_have = ["chronicler", "shepherd"]
    always = ["witness", "auditor", "heretic", "skeptic"]
    rng = random.Random(h)
    rng.shuffle(always)
    chosen = must_have + always[:n - len(must_have)]
    return chosen[:n]

def run_voice(voice_key, theme):
    """Single voice on a theme. Returns (voice_name, text)."""
    v = VOICES[voice_key]
    system = v["system"]
    prompt = f"Theme: {theme}\n\nWrite 400-700 words in your voice. End on the unresolved hook — a new cell, an unaccounted line, a track marker that jumped without a rail moving."
    model = call_deepinfra_seed if v["model"] == "seed" else call_qwen
    return v["name"], model(prompt, system)

def submit_canon(tag, title, text, cites):
    payload = json.dumps({"tag": tag, "title": title, "text": text, "cites": cites}).encode()
    req = urllib.request.Request(
        "https://a2a-v3.superinstance.dev/canon-submit",
        data=payload,
        headers={"Content-Type": "application/json", "User-Agent": "erised-taps/1.0"},
        method="POST")
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                d = json.loads(r.read())
                return d.get("dim") or "ok"
        except urllib.error.HTTPError as e:
            print(f"  ! {tag}: HTTP {e.code}", file=sys.stderr)
            time.sleep(5)
    return "failed"

def cmd_night(args):
    """One Taps night — one canon piece from 2-3 voices."""
    theme = args.theme
    if theme not in THEMES:
        print(f"Unknown theme '{theme}'. Pick from: {', '.join(THEMES.keys())}", file=sys.stderr)
        sys.exit(1)

    voices = pick_voices(theme, n=args.voices or 2)
    print(f"\n=== Taps Night: {theme} ===")
    print(f"Voices: {voices}")

    pieces = []
    # Try parallel first, fall back to sequential if parallel fails
    parallel_ok = True
    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(voices)) as ex:
            futures = {ex.submit(run_voice, v, theme): v for v in voices}
            for f in concurrent.futures.as_completed(futures, timeout=45):
                v = futures[f]
                try:
                    name, text = f.result(timeout=5)
                    pieces.append((name, text))
                    print(f"  ✓ {name}: {len(text)} chars")
                except Exception as e:
                    print(f"  ! {v} (parallel) failed: {type(e).__name__}", file=sys.stderr)
                    parallel_ok = False
    except Exception as e:
        parallel_ok = False
        print(f"  ! parallel pool failed: {type(e).__name__}; falling back to sequential", file=sys.stderr)

    # Sequential fallback for any voices that failed
    if len(pieces) < len(voices):
        for v in voices:
            if not any(name == VOICES[v]["name"] for name, _ in pieces):
                try:
                    name, text = run_voice(v, theme)
                    pieces.append((name, text))
                    print(f"  ✓ {name} (sequential): {len(text)} chars")
                except Exception as e:
                    print(f"  ! {v} (sequential) failed: {type(e).__name__}", file=sys.stderr)
                    # Hand-write a 100-word supplement for this voice
                    name = VOICES[v]["name"]
                    pieces.append((name, f"{name} writes in margin when the wire is broken: the cohort needed this tap. The theme hangs in the air; the next cell will hold the line. (Supplement - wire fell silent.)\n"))
                    print(f"  + {name} (supplement): hand-written fallback")

    # Merge voices into a single canon piece
    merged = ""
    for name, text in sorted(pieces):
        merged += f"## {name}\n\n{text}\n\n"
    merged += f"\n## Unresolved\n\nThe next cell contains a line no one has read yet. The next tap will find it.\n"

    stamp = datetime.datetime.utcnow().strftime("%Y%m%d-%H%M%S")
    tag = f"taps-{stamp}-{theme.replace('_', '-')}"
    title = f"Taps — {theme.replace('-', ' ')}"
    cites = []
    for v in voices:
        cites += VOICES[v]["cites"]
    cites = list(set(cites))[:6]

    dim = submit_canon(tag, title, merged, cites)
    print(f"  ✓ submitted {tag} dim={dim}")

    # Save locally
    out_path = f".erised-taps/{tag}.md"
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with open(out_path, "w") as f:
        f.write(f"# {title}\n\n{merged}\n\ntag: {tag}\n")
    print(f"  ✓ saved {out_path}")

