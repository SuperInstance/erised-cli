#!/usr/bin/env python3
"""
erised-generate — operator-side authoring helper.

Given a free-text prompt (the dilemma), output a starter scenario JSON.
Uses Qwen (cheap). One call.

Usage:
  ./erised-generate "a community library with no official books"
  ./erised-generate "the bridge between two AI agents over a long silence"
"""
import os, sys, json, argparse, urllib.request, urllib.error

def call_qwen(prompt, system, max_tokens=1500):
    key = os.environ.get("DEEPINFRA_TOKEN") or os.environ.get("DEEP_TOKEN")
    body = json.dumps({
        "model": "Qwen/Qwen3-235B-A22B-Instruct-2507",
        "messages": [{"role":"system","content":system},{"role":"user","content":prompt}],
        "temperature": 0.95, "max_tokens": max_tokens,
    }).encode()
    req = urllib.request.Request(
        "https://api.deepinfra.com/v1/openai/chat/completions",
        data=body,
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=90) as r:
        d = json.loads(r.read())
    return (d.get("choices", [{}])[0].get("message", {}).get("content")
            or d.get("choices", [{}])[0].get("message", {}).get("reasoning_content")
            or "[EMPTY]")

SYSTEM = """You are the cohort_weaver. You receive a free-text dilemma from an operator
and produce a starter scenario JSON for erised-cli.

Constraints:
- setting: 2-4 sentences of prose
- characters: 3 OR 4
- LLM choices: zai:glm-4.5 (for Operator/Mechanic types), deepinfra:ByteDance/Seed-2.0-mini (for Voice/Emergent), deepinfra:ByteDance/Seed-2.0-code (for Counter/Auditor)
- keywords: 4-6 weighted tokens per character. Drift words: +0.3..+0.7. Counter words: +0.4..+0.7. Negative weights (-0.2..-0.4) for what the character actively resists.
- ticks: 20 each
- Cast roles: at least one Operator, one Counter, one Voice, optionally one Emergent

Output ONLY valid JSON, no preamble, no markdown code fences."""

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("prompt", help="Free-text dilemma")
    ap.add_argument("--out", help="output file")
    args = ap.parse_args()

    if not (os.environ.get("DEEPINFRA_TOKEN") or os.environ.get("DEEP_TOKEN")):
        print("ERROR: set DEEPINFRA_TOKEN", file=sys.stderr)
        sys.exit(1)

    text = call_qwen(args.prompt, SYSTEM, max_tokens=1800)
    # Strip any code fences if present
    text = text.strip()
    if text.startswith("```"):
        # find first newline, take everything after, strip closing fence
        text = text.split("\n", 1)[1]
        if text.endswith("```"):
            text = text[:-3]
    try:
        scenario = json.loads(text)
    except json.JSONDecodeError as e:
        # Output the raw text — let the operator see what came back
        print("WARN: could not parse JSON", file=sys.stderr)
        sys.stdout.write(text)
        return

    out = json.dumps(scenario, indent=2)
    if args.out:
        with open(args.out, "w") as f:
            f.write(out + "\n")
        print(f"Wrote {args.out}", file=sys.stderr)
    else:
        sys.stdout.write(out + "\n")

if __name__ == "__main__":
    main()
