# --- Main ------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(description="erised — terminal mirror for cooperative fiction")
    ap.add_argument("scenario", nargs="?", help="path to YAML or JSON scenario")
    ap.add_argument("--rounds", type=int, default=4)
    ap.add_argument("--quiet", action="store_true", help="no per-round prints")
    ap.add_argument("--init", action="store_true", help="print a template scenario")
    ap.add_argument("--out", help="write JSON result to this file")
    args = ap.parse_args()

    if args.init:
        sys.stdout.write(TEMPLATE)
        return

    if not args.scenario:
        ap.error("scenario file required (or --init)")

    if not (os.environ.get("DEEPINFRA_TOKEN") or os.environ.get("DEEP_TOKEN")):
        print("ERROR: set DEEPINFRA_TOKEN (or DEEP_TOKEN)", file=sys.stderr)
        sys.exit(1)

    with open(args.scenario) as f:
        raw = f.read()

    # Parse: try yaml first, then json
    scenario = None
    if yaml:
        try: scenario = yaml.safe_load(raw)
        except: pass
    if scenario is None:
        try: scenario = json.loads(raw)
        except: pass
    if scenario is None:
        print("ERROR: could not parse scenario (not yaml or json)", file=sys.stderr)
        sys.exit(1)

    result = run(scenario, rounds=args.rounds, verbose=not args.quiet)
    if args.out:
        with open(args.out, "w") as f:
            json.dump(json.loads(json.dumps(result, default=str)), f, indent=2)
        print(f"\nSaved {args.out}", file=sys.stderr)

if __name__ == "__main__":
    main()
